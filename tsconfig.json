{
  "include": [
    "src",
    "eslint.config.mjs",
    "webpack.config.mjs"
  ],
  "exclude": ["node_modules", "**/*.spec.js"],
  "compilerOptions": {
    "rootDir": ".",
    "esModuleInterop": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noImplicitAny": true,
    "outDir": "./public",
    "removeComments": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "target": "ESNext",
  }
}